rules_version = '2';

// The client app never talks to Firestore directly — only the Vercel
// serverless functions do, via the Admin SDK, which bypasses these rules
// entirely. This file just makes sure that stays true: if anyone ever
// adds the Firebase client SDK to the frontend by mistake, it gets
// nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
